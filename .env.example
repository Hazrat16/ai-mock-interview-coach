# Copied to .env by `make setup`. __HOME__ is replaced with your home directory.

# App server (dev UI runs on Vite at 5173 and proxies /api here)
HOST=127.0.0.1
PORT=4317

# Model files (large, read-mostly)
MODELS_DIR=/media/hazrat/Hazrat8/ai-models
# SQLite database, backups, logs. Kept off the NTFS drive: SQLite locking is unreliable on FUSE mounts.
DATA_DIR=__HOME__/.local/share/ai-interview-coach

# Ollama container
OLLAMA_IMAGE_TAG=0.40.13
OLLAMA_PORT=11435
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MEM_LIMIT=7g
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_LENGTH=8192

# Models (chosen from docs/benchmarks/2026-10-29-model-decision.md)
# Live interview: fast. Evaluation after the interview: higher quality. Fallback: used if the evaluator fails.
INTERVIEWER_MODEL=granite4:3b
EVALUATOR_MODEL=qwen3.5:4b
FALLBACK_MODEL=granite4:3b
# CPU threads for the LLM (8 was fastest on the i7-1355U; Ollama's default was slower)
LLM_NUM_THREAD=8

# Piper text-to-speech container (voices: shared/voices.ts, downloaded by make voices)
PIPER_PORT=5150
PIPER_URL=http://127.0.0.1:5150
PIPER_DEFAULT_VOICE=en_US-ljspeech-medium
# Typical use is ~300 MB (one voice); each extra voice tried adds ~230 MB until Piper restarts.
PIPER_MEM_LIMIT=2g
