# Copied to .env by `make init`. __HOME__ is replaced with your home directory.

# Model files (large, read-mostly): fine on the NTFS drive.
MODELS_DIR=/media/hazrat/Hazrat8/ai-models
# Database, backups, logs: MUST be on ext4 (not NTFS/FUSE).
DATA_DIR=__HOME__/.local/share/ai-interview-coach

# Ollama container
OLLAMA_IMAGE_TAG=0.40.13
OLLAMA_MEM_LIMIT=7g
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_LENGTH=8192

# Models
INTERVIEWER_MODEL=qwen3.5:4b
FALLBACK_MODEL=granite4:3b
PULL_MODELS="qwen3.5:4b granite4:3b"
