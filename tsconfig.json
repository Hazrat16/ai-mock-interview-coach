{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./web/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["web/src", "server", "shared", "scripts", "vite.config.ts", "vitest.config.ts", "eslint.config.js", "e2e", "playwright.config.ts"]
}
